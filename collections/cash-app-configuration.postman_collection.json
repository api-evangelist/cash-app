              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"minimumAmount\": {\n    \"amount\": \"string\",\n    \"currency\": \"NZD\"\n  },\n  \"maximumAmount\": {\n    \"amount\": \"string\",\n    \"currency\": \"USD\"\n  },\n  \"publicId\": \"string\",\n  \"consumerLending\": {\n    \"enabled\": true,\n    \"minimumAmount\": {\n      \"amount\": \"string\",\n      \"currency\": \"USD\"\n    },\n    \"maximumAmount\": {\n      \"amount\": \"string\",\n      \"currency\": \"GBP\"\n    }\n  },\n  \"payByInstallment\": {\n    \"minimumAmount\": {\n      \"amount\": \"string\",\n      \"currency\": \"NZD\"\n    },\n    \"maximumAmount\": {\n      \"amount\": \"string\",\n      \"currency\": \"CAD\"\n    }\n  }\n}",
